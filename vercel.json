{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/cards",
      "destination": "/api/cards/index"
    },
    {
      "source": "/api/cards/:id",
      "destination": "/api/cards/[id]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
