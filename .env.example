# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Optional app hosting URL
APP_URL=""

# ─── CLOUD DATABASE CONFIGURATION FOR VERCEL ─────────────────────
# Option 1 (Recommended): Vercel KV / Upstash Redis (1-Click on Vercel Dashboard -> Storage -> KV)
# Khi kết nối Vercel KV, Vercel sẽ tự động điền các biến này:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Hoặc nếu bạn tạo Upstash Redis trực tiếp trên https://upstash.com:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Option 2 (Alternative): Supabase
# Nếu bạn dùng Supabase thay vì Redis:
SUPABASE_URL=""
SUPABASE_KEY=""

